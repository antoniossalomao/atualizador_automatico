; Copie este arquivo para "atualizador.ini" (mesma pasta do AtualizadorERP.exe) e preencha os
; valores abaixo. O agente lê esse arquivo uma vez, na inicializacao -- se faltar alguma chave
; obrigatoria, ele recusa subir em vez de rodar meio configurado.
;
; "atualizador.ini" NUNCA deve ser commitado (tem credencial de verdade) -- ja esta no .gitignore
; do repositorio (*.ini). Esse .example, sem segredo nenhum, e' o unico dos dois que fica versionado.
;
; Convencao de pastas: o agente mora dentro da propria pasta do cliente (ex.: Bredas\Atualizador\),
; ao lado de JUNIOR.fdb/BEXE.fdb um nivel acima. Se a sua instalacao seguir esse padrao, as chaves
; de caminho abaixo (JUNIOR_FDB, BEXE_FDB, PASTA_TRABALHO, PASTA_BACKUPS) podem ficar comentadas --
; os defaults ja resolvem certo. Só descomente se a estrutura desse cliente for diferente.

; ---- Obrigatorias ----

; Codigo do cliente cadastrado na aba Clientes do painel web (coluna "codigo",
; ex.: C016058) -- nao precisa ser CNPJ de verdade, e' so' um identificador
; livre. Se bater com o "codigo" de um cliente cadastrado, o painel mostra o
; nome/cidade certos nos logs desse agente; se nao bater com nenhum, ainda
; funciona igual, so' aparece o valor cru em vez do nome da empresa.
CODIGO_CLIENTE=

; Lista de TODOS os sistemas que a empresa distribui, cada um como "NomeNoPainel:nome_do_exe.exe"
; separado por virgula. NomeNoPainel precisa bater, letra por letra, com o nome cadastrado na aba
; Sistemas do painel web -- mas o nome do arquivo .exe raramente bate com o nome do sistema (ex.:
; sistema "B_Importa", arquivo real "BImportaXML.exe"), entao precisa informar os dois.
;
; Pode (e deve) copiar essa MESMA lista completa em todo cliente -- o agente checa sozinho, a cada
; ciclo, quais desses .exe realmente existem na pasta do cliente (ao lado do BEXE.fdb) e SO baixa/
; aplica atualizacao dos sistemas que esse cliente especifico tem instalado. Sem esse filtro,
; publicar uma versao nova de QUALQUER sistema faria todo cliente tentar baixa-la, mesmo quem nunca
; teve aquele sistema instalado.
; Ex.: SISTEMAS=B_Vendas:B_Vendas.exe,B_NFe:B_NFE.exe,B_Ordem:B_Ordem_Servico.exe,B_Importa:BImportaXML.exe
SISTEMAS=

; Opcional (default vazio). Lista separada por virgula de QUAIS sistemas de SISTEMAS podem rodar
; script contra o JUNIOR.fdb (gfix -shut, backup, aplicar .sql). Todo sistema que NAO estiver
; aqui e' tratado como "so troca de executavel": nunca roda script, MESMO que o pacote baixado
; contenha .sql (alguns pacotes trazem .sql junto sem ser pra rodar -- rodar por engano quebra o
; banco). Nao deixe isso vazio pensando que o agente vai descobrir sozinho pelo conteudo do
; pacote -- ele nao descobre, e' de proposito.
; Ex.: SISTEMAS_COM_SCRIPT=B_Vendas
SISTEMAS_COM_SCRIPT=

; Opcional (default vazio). Lista separada por virgula de nomes de arquivo .sql que o agente
; NUNCA deve tentar rodar, mesmo que apareçam pendentes num pacote -- pra scripts legados
; conhecidos como quebrados de origem (ex.: um corpo de procedure salvo sem o cabeçalho "ALTER
; PROCEDURE"), onde nenhuma correção automática resolve porque o proprio arquivo esta incompleto.
; So' o nome do arquivo, sem caminho -- fica pendente pra sempre (sem erro reportado) ate alguem
; corrigir o arquivo de origem e tirar da lista.
;
; A lista abaixo ja vem preenchida como default: sao scripts legados do proprio B_Vendas (nao
; especificos de um cliente -- o mesmo historico de Scripts-BVendas se repete em qualquer
; instalacao do produto), confirmados quebrados rodando os 1027 scripts reais contra um JUNIOR.fdb
; de producao (nome de tabela que nao bate mais com o banco real, coluna/constraint ja apagada
; manualmente, corpo de trigger/procedure incompleto ou com erro de sintaxe de origem). Se um
; cliente especifico corrigir um desses arquivos na propria copia (ex.: adicionando um "^" que
; faltava), tira ele desta lista no atualizador.ini DESSE cliente -- nao precisa mexer aqui.
SCRIPTS_IGNORADOS=20241009Altera_Procedure_Inventario_NFCe.sql,20070409Cria_campo_icms_tab_empresa.sql,20070409Cria_campo_preco_dolar_tab_empresa.sql,20070409Cria_campo_utiliza_grade_produto_tab_empresa.sql,20071220Cria_campos_atualiza_saldos_tabela_empresa.sql,20080102Cria_campos_atualiza_validade_lote_tabela_empresa.sql,20110114Cria_campo_CAS_DEC_QTDE_Tabela_Empresa.sql,20110114Cria_campo_CAS_DEC_VALOR_Tabela_Empresa.sql,20110114Cria_campo_EMP_UTIL_PRECO_CUSTO_TAB_PROD_Tabela_Empresa.sql,20110114Valor_campo_CAS_DEC_QTDE_Tabela_Empresa.sql,20110114Valor_campo_EMP_CAS_DEC_VALOR_Tabela_Empresa.sql,20110114Valor_campo_EMP_UTIL_PRECO_CUSTO_TAB_PROD_Tabela_Empresa.sql,20200204Cria_campo_CODTABPRECO_em_FSPEDIDOITENS.sql,20230116Altera_tabela_PPP_EXCLUIDO_adiciona_motivo.sql,20080129Deleta_Relaciona_tabela_processo.sql,20080130Deleta_campo_tabela_receita_processo.sql,20170508Aparaga_trigger_CHECKOUT_NATOP_BIU100.sql,20200813Altera_Campos_Tabela_Nutricional.sql,20220225Cria_Trigger_PRE_PEDIDO_ITENS_CANCELADOS_AU0.sql,20260416Altera_Trigger_ITEM_PROD_INS_RECEITA_REQUISICA.sql

; Precisa bater com o AGENT_API_TOKEN configurado no servidor (web/server/.env).
API_TOKEN=

; Senha do usuario do Firebird (DB_USER abaixo, SYSDBA por padrao).
DB_PASSWORD=

; ---- Opcionais (comentadas = usa o valor padrao) ----

; API_URL=http://localhost:3000/api
; DB_USER=SYSDBA
; DB_PORT=3050
; GFIX_PATH=C:\Program Files (x86)\Firebird\Firebird_2_5\bin\gfix.exe
; GBAK_PATH=C:\Program Files (x86)\Firebird\Firebird_2_5\bin\gbak.exe
; ISQL_PATH=C:\Program Files (x86)\Firebird\Firebird_2_5\bin\isql.exe

; Caminho do JUNIOR.fdb deste cliente. Default: "..\JUNIOR.FDB" (um nivel acima da pasta do
; agente) -- so' precisa preencher se a estrutura real fugir disso.
; JUNIOR_FDB=..\JUNIOR.FDB

; Caminho do BEXE.fdb deste cliente. Default: "..\BEXE.FDB". E' tambem a partir da pasta ONDE
; ESTE ARQUIVO ESTIVER que o agente monta o caminho completo gravado em EXECUTAVEIS.NOMEARQUIVO
; (ex.: "D:\Bredas\B_Vendas.exe") -- então aponte pro BEXE.fdb real do cliente, não uma copia.
; BEXE_FDB=..\BEXE.FDB

; Pasta de trabalho descartavel (downloads/extracao/backup em andamento). Default: "_trabalho"
; dentro da propria pasta do agente.
; PASTA_TRABALHO=_trabalho

; Pasta de backups PERSISTENTE (nunca e' varrida pela limpeza automatica). Default: "Backups"
; dentro da propria pasta do agente.
; PASTA_BACKUPS=Backups

; Quantos ciclos de atualizacao bem-sucedidos ficam guardados em PASTA_BACKUPS (pre + pos cada
; um) antes de o mais antigo ser apagado automaticamente. Default: 10.
; BACKUPS_PARA_MANTER=10
